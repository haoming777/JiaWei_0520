<Window x:Class="Wpf_Loading.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen" Topmost="True"
        ShowInTaskbar="False" Width="620" Height="360"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="#FFE2E8F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border CornerRadius="3" Background="{TemplateBinding Background}">
                            <Border x:Name="PART_Track" CornerRadius="3">
                                <Border x:Name="PART_Indicator" CornerRadius="3"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" BorderBrush="#FFE2E8F0" BorderThickness="1" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFF8FAFC" Offset="0.0"/>
                <GradientStop Color="#FFFFFFFF" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="2" Opacity="0.12" Color="#FF0F172A"/>
        </Border.Effect>

        <Grid>
            <Button x:Name="btnClose" Width="32" Height="32"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,8,8,0" Background="Transparent" BorderThickness="0"
                    Cursor="Hand" Click="BtnClose_Click"
                    ToolTip="取消加载并退出程序" Panel.ZIndex="10">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="16">
                            <Grid Width="16" Height="16">
                                <Path x:Name="cross" Data="M4,4 L12,12 M12,4 L4,12"
                                      Stroke="#FF475569" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFEF5350"/>
                                <Setter TargetName="cross" Property="Stroke" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Grid Margin="50,22,50,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <TextBlock Text="广州高露洁牙膏字符检测" FontSize="20" FontWeight="SemiBold"
                               Foreground="#FF0F172A" FontFamily="Segoe UI, Microsoft YaHei UI" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="txtStatus" Text="正在准备，请耐心等待..." FontSize="12" Foreground="#FF374151"
                               FontFamily="Segoe UI, Microsoft YaHei UI" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <Grid x:Name="spinnerContainer" Grid.Row="1" Width="100" Height="100" HorizontalAlignment="Center" Margin="0,6,0,6"/>

                <TextBlock x:Name="txtStepLabel" Grid.Row="2" Text="正在初始化系统组件..." FontSize="13"
                           Foreground="#FF1E293B" FontFamily="Segoe UI, Microsoft YaHei UI"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10"/>

                <ProgressBar x:Name="progressBar" Grid.Row="3" Style="{StaticResource ModernProgressBar}"
                             Minimum="0" Maximum="100" Value="0" Foreground="#FF2563EB" Margin="20,0,20,6"/>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                    <TextBlock x:Name="txtPercent" Text="0%" FontSize="28" FontWeight="Bold"
                               Foreground="#FF2563EB" FontFamily="Segoe UI, Microsoft YaHei UI"/>
                    <TextBlock x:Name="txtElapsed" Text="" FontSize="12" Foreground="#FF475569"
                               FontFamily="Segoe UI, Microsoft YaHei UI" VerticalAlignment="Bottom" Margin="14,0,0,6"/>
                </StackPanel>

                <TextBlock Grid.Row="5" Text="请稍候..." FontSize="12" Foreground="#FF475569"
                           FontFamily="Segoe UI, Microsoft YaHei UI" HorizontalAlignment="Center"/>

                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <TextBlock x:Name="txtDateTime" Text="" FontSize="10" Foreground="#FF475569" FontFamily="Segoe UI, Microsoft YaHei UI"/>
                </StackPanel>
                <TextBlock Grid.Row="7" Text="v1.0.0  © Colgate-Palmolive" FontSize="10"
                           Foreground="#FF475569" FontFamily="Segoe UI, Microsoft YaHei UI"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
