<Window x:Class="CameraSwitchTool.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示"
        Width="440" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="Transparent" AllowsTransparency="True"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei" FontSize="14"
        TextOptions.TextFormattingMode="Display">
    <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <StackPanel>
            <!-- 标题 -->
            <Grid Height="48">
                <TextBlock x:Name="TitleText" Margin="20,0,56,0" VerticalAlignment="Center"
                           FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <Button Style="{StaticResource DialogCloseButtonStyle}" HorizontalAlignment="Right"
                        Content="✕" Click="CloseButton_Click"/>
            </Grid>
            <Border Height="1" Background="{StaticResource DividerBrush}"/>

            <!-- 内容 -->
            <StackPanel Margin="24,20,24,20">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="IconBorder" Width="40" Height="40" CornerRadius="20" VerticalAlignment="Top">
                        <TextBlock x:Name="IconGlyph" Foreground="{StaticResource TextOnPrimaryBrush}"
                                   FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="16,0,0,0" MaxWidth="336">
                        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}" LineHeight="22"/>
                        <TextBlock x:Name="DetailText" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" LineHeight="18"
                                   Margin="0,8,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button x:Name="SecondaryButton" Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0" Click="SecondaryButton_Click" IsCancel="True"/>
                    <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="96" Click="PrimaryButton_Click" IsDefault="True"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
