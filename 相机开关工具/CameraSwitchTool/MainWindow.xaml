<Window x:Class="CameraSwitchTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="相机开关配置工具"
        Icon="App.ico"
        Width="560" Height="820"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent" AllowsTransparency="True"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei" FontSize="14"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- 相机开关行模板：序号徽标 + 名称/说明 + 滑动开关 -->
        <DataTemplate x:Key="CameraRowTemplate">
            <Border Padding="0,12" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource BadgeBorderStyle}">
                        <TextBlock Text="{Binding Index}" Style="{StaticResource BadgeTextStyle}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitleTextStyle}"/>
                        <TextBlock Text="{Binding Caption}" Style="{StaticResource RowCaptionTextStyle}"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="2" Style="{StaticResource FlatToggleSwitch}"
                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="8" Background="{StaticResource AppBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                        <Border Style="{StaticResource AppIconBorderStyle}">
                            <Path Fill="{StaticResource TextOnPrimaryBrush}"
                                  Width="18" Height="18" Stretch="Uniform">
                                <Path.Data>
                                    <PathGeometry FillRule="EvenOdd"
                                                  Figures="M4,7 L7.5,7 L9.5,4.5 L14.5,4.5 L16.5,7 L20,7 A2,2,0,0,1,22,9 L22,19 A2,2,0,0,1,20,21 L4,21 A2,2,0,0,1,2,19 L2,9 A2,2,0,0,1,4,7 Z M12,10.5 A3.5,3.5,0,1,0,12,17.5 A3.5,3.5,0,1,0,12,10.5"/>
                                </Path.Data>
                            </Path>
                        </Border>
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="相机开关配置" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="高露洁牙膏管视觉检测系统" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource ChipBorderStyle}" Margin="0,0,16,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource ChipDotStyle}" Width="8" Height="8"
                                     VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource ChipTextStyle}" Margin="8,0,0,0" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Button Grid.Column="2" Style="{StaticResource TitleBarButtonStyle}"
                            Content="─" Click="MinimizeButton_Click"/>
                    <Button Grid.Column="3" Style="{StaticResource CloseButtonStyle}"
                            Content="✕" Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- 内容区 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16,24,8">
                <StackPanel>
                    <!-- 卡片：工位启用 -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="工位启用（ActiveCam）" Style="{StaticResource SectionTitleTextStyle}"/>
                                <Border Style="{StaticResource PillStyle}" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="重启后生效" Style="{StaticResource PillTextStyle}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="控制各工位是否参与检测。主程序启动时读取一次，修改后需重启主程序才能生效。至少需启用一个工位。"
                                       Style="{StaticResource SectionDescTextStyle}"/>
                            <ItemsControl ItemsSource="{Binding StationItems}"
                                          ItemTemplate="{StaticResource CameraRowTemplate}" Margin="0,8,0,0"/>
                            <Border Style="{StaticResource WarningBarStyle}" Margin="0,16,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="!" FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource DangerDarkBrush}" Width="16"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="至少需启用一个工位，否则无法保存设置" FontSize="12"
                                               Foreground="{StaticResource DangerDarkBrush}"
                                               Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 卡片：AI 推理开关 -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,24,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="AI 推理开关（IFRunCamera）" Style="{StaticResource SectionTitleTextStyle}"/>
                                <Border Style="{StaticResource PillStyle}" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="重启后生效" Style="{StaticResource PillTextStyle}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="控制各相机是否运行 AI 推理。关闭后对应相机跳过推理（可用于屏蔽故障相机或调试提速）。修改后需重启主程序才能生效。"
                                       Style="{StaticResource SectionDescTextStyle}"/>
                            <ItemsControl ItemsSource="{Binding InferenceItems}"
                                          ItemTemplate="{StaticResource CameraRowTemplate}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部操作栏 -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8" Padding="24,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Style="{StaticResource DirtyDotStyle}" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource DirtyTextStyle}" Margin="8,0,0,0" FontSize="12"/>
                        </StackPanel>
                        <TextBlock Text="{Binding IniPath}" Style="{StaticResource FooterCaptionTextStyle}" MaxWidth="200"/>
                        <TextBlock Text="{Binding LastSavedText}" Style="{StaticResource FooterCaptionTextStyle}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Content="放弃修改"
                            Command="{Binding DiscardCommand}" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="重启主程序"
                            Command="{Binding RestartCommand}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Style="{StaticResource PrimaryButtonStyle}" Content="保存设置"
                            Command="{Binding SaveCommand}" MinWidth="96" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
